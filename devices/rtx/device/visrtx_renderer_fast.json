{
  "info": {
    "name": "VISRTX_RENDERER_FAST",
    "type": "extension",
    "dependencies": [
      "anari_core_1_0"
    ],
    "implements": [
      "khr_renderer_background_color",
      "khr_renderer_background_image",
      "khr_renderer_ambient_light"
    ]
  },
  "objects": [
    {
      "type": "ANARI_RENDERER",
      "name": "fast",
      "parameters": [
        {
          "name": "sampleLimit",
          "types": [
            "ANARI_INT32"
          ],
          "tags": [],
          "default": 128,
          "minimum": 0,
          "description": "stop refining the frame after this number of samples"
        },
        {
          "name": "fixedAmbientLighting",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": true,
          "description": "ignore 'ambientRadiance' and 'ambientColor' parameters on the renderer"
        },
        {
          "name": "denoise",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": false,
          "description": "enable the OptiX denoiser"
        },
        {
          "name": "denoiseMode",
          "types": [
            "ANARI_STRING"
          ],
          "tags": [],
          "default": "colorAlbedoNormal",
          "values": [
            "colorAlbedoNormal",
            "colorAlbedo",
            "color"
          ],
          "description": "mode controlling buffers given to the denoiser"
        },
        {
          "name": "fireflyFilter",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": true,
          "description": "suppress fireflies via reversible tonemapping before accumulation"
        },
        {
          "name": "premultiplyBackground",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": false,
          "description": "pre-multiply alpha channel with background color"
        },
        {
          "name": "cullTriangleBackfaces",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": false,
          "description": "enable triangle back face culling"
        },
        {
          "name": "checkerboarding",
          "types": [
            "ANARI_BOOL"
          ],
          "tags": [],
          "default": false,
          "description": "use checkerboarding to lower frame latency"
        },
        {
          "name": "pixelSamples",
          "types": [
            "ANARI_INT32"
          ],
          "tags": [],
          "default": 1,
          "minimum": 1,
          "description": "samples per-pixel"
        },
        {
          "name": "ambientSamples",
          "types": [
            "ANARI_INT32"
          ],
          "tags": [],
          "default": 4,
          "minimum": 0,
          "description": "AO samples per-pixel, per-frame"
        },
        {
          "name": "ambientOcclusionDistance",
          "types": [
            "ANARI_FLOAT32"
          ],
          "tags": [],
          "default": 1e20,
          "minimum": 0,
          "description": "ambient occlusion distance"
        },
        {
          "name": "aoBlend",
          "types": [
            "ANARI_FLOAT32"
          ],
          "tags": [],
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "blend between NdotL headlight shading (0) and ambient occlusion (1)"
        },
        {
          "name": "volumeSamplingRate",
          "types": [
            "ANARI_FLOAT32"
          ],
          "tags": [],
          "default": 0.125,
          "minimum": 0.001,
          "maximum": 10.0,
          "description": "sampling rate of volumes when ray marching"
        },
        {
          "name": "cutPlane",
          "types": [
            "ANARI_FLOAT32_VEC4"
          ],
          "tags": [],
          "default": [
            0.0,
            0.0,
            0.0,
            0.0
          ],
          "description": "cutting plane equation (nx, ny, nz, d); disabled when all zero (vec4(0))"
        }
      ]
    }
  ]
}